// Generated by npm run prepare:registration; edit registration/core.mjs instead.
// Shared, dependency-free validation. prepare-registration.mjs copies this into Apps Script.
const RegistrationCore = (() => {
  const choices = {
    category: ['Regular participant', 'Student participant', 'Accompanying person'],
    membership: ['Member', 'Non-member'],
    participation: ['Presenting author', 'Non-presenting participant'],
    presentation: ['Oral presentation', 'Poster presentation', 'Not yet confirmed'],
    studentStatus: ['Full-time student', 'Part-time student'],
    invitation: ['Yes', 'No'],
    workshop: ['Interested', 'Not interested', 'Undecided']
  };
  const limits = {
    title: 40, givenName: 100, familyName: 100, email: 254, confirmEmail: 254,
    phone: 32, institution: 200, department: 200, country: 100, position: 100,
    category: 40, membership: 20, participation: 40, presentation: 40,
    abstractIds: 300, degree: 120, studentStatus: 40, dietary: 500,
    invitation: 10, workshop: 30, accessibility: 500, comments: 1000,
    privacy: 10, terms: 10, accuracy: 10, synthetic: 10,
    submissionKey: 80, startedAt: 20, mode: 10, website: 200, consentVersion: 50
  };
  function validate(input, mode) {
    const data = {}, errors = {};
    for (const [key, max] of Object.entries(limits)) {
      const raw = input[key];
      data[key] = typeof raw === 'string' ? raw.trim() : '';
      if (data[key].length > max) errors[key] = `Use no more than ${max} characters.`;
      if (/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/.test(data[key])) errors[key] = 'Remove unsupported control characters.';
    }
    for (const key of ['givenName','email','confirmEmail','phone','institution','department','country','position']) {
      if (!data[key]) errors[key] = 'Please complete this field.';
    }
    const emailPattern = /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/;
    if (!emailPattern.test(data.email)) errors.email = 'Enter a valid email address.';
    if (data.email.toLowerCase() !== data.confirmEmail.toLowerCase()) errors.confirmEmail = 'Email addresses must match.';
    if (!/^\+[1-9][0-9 ()-]{6,30}$/.test(data.phone) || data.phone.replace(/\D/g,'').length > 15 || data.phone.replace(/\D/g,'').length < 7) errors.phone = 'Use an international number, for example +62 812 0000 0000.';
    for (const key of ['category','membership','participation','invitation','workshop']) {
      if (!choices[key].includes(data[key])) errors[key] = 'Please select an option.';
    }
    if (data.participation === 'Presenting author') {
      if (!choices.presentation.includes(data.presentation)) errors.presentation = 'Please select a presentation type.';
      if (data.abstractIds && !/^[A-Za-z0-9_-]+(?:[\s,;]+[A-Za-z0-9_-]+)*$/.test(data.abstractIds)) errors.abstractIds = 'Separate CMT IDs with commas, spaces, or semicolons.';
      if (data.abstractIds.split(/[\s,;]+/).filter(Boolean).length > 20) errors.abstractIds = 'Enter no more than 20 abstract IDs.';
    } else { data.presentation = ''; data.abstractIds = ''; }
    if (data.category === 'Student participant') {
      if (!data.degree) errors.degree = 'Enter your degree programme.';
      if (!choices.studentStatus.includes(data.studentStatus)) errors.studentStatus = 'Please select your student status.';
    } else { data.degree = ''; data.studentStatus = ''; }
    for (const key of ['privacy','terms','accuracy']) if (data[key] !== 'yes') errors[key] = 'Please acknowledge this statement.';
    if (mode !== 'LIVE') {
      if (data.synthetic !== 'yes') errors.synthetic = 'Confirm that you are using synthetic test information.';
      if (mode === 'DEMO' && !/@example\.invalid$/i.test(data.email)) errors.email = 'For this demo, use an address ending in @example.invalid.';
    }
    return {data, errors, valid: Object.keys(errors).length === 0};
  }
  function safeCell(value) {
    const text = String(value ?? '');
    return /^[\s\u200b\ufeff]*[=+\-@]/.test(text) || /^[\t\r\n]/.test(text) ? "'" + text : text;
  }
  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  return {choices, limits, validate, safeCell, escapeHtml};
})();
