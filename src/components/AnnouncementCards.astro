---
import {announcements} from '../utils/content';
import {withBase} from '../utils/url';
import Icon from './Icon.astro';
interface Props{limit?:number;}
const posts=announcements.slice(0,Astro.props.limit);
---
<div class="announcement-grid">{posts.map(post=><article class="announcement-card"><div><span class="pill">{post.frontmatter.category}</span><time datetime={post.frontmatter.date}>{new Intl.DateTimeFormat('en',{dateStyle:'medium',timeZone:'UTC'}).format(new Date(`${post.frontmatter.date}T12:00:00Z`))}</time></div><h3><a href={withBase(`news/${post.slug}/`)}>{post.frontmatter.title}</a></h3><p>{post.frontmatter.summary}</p><a class="text-link" href={withBase(`news/${post.slug}/`)}>Read update<Icon size={16}/></a></article>)}</div>
