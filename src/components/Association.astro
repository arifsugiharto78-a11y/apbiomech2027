---
import association from '../data/association.json';
import conference from '../data/conference.json';
import {withBase} from '../utils/url';
import Icon from './Icon.astro';
interface Props{full?:boolean;}
const {full=false}=Astro.props;
const logo=conference.logos.find(logo=>logo.kind==='association');
---
<section class:list={['association-section',{'association-full':full}]} aria-label="About the Asian-Pacific Association for Biomechanics">
  <div class="association-mark">{logo&&<a href={association.url} target="_blank" rel="noopener noreferrer" aria-label="Visit the official APAB association website"><img src={withBase(logo.image)} alt="Asian-Pacific Association for Biomechanics (APAB) logo" width="160" height="160" loading="lazy"/></a>}</div>
  <div class="association-copy"><p class="eyebrow">THE ACADEMIC ASSOCIATION</p><h2>About Asian-Pacific Association for Biomechanics</h2>
  {full?<><p class="association-attribution">Association introduction · {association.attribution}</p><blockquote>{association.introduction.map(paragraph=><p>{paragraph}</p>)}</blockquote><a class="text-link" href={association.url} target="_blank" rel="noopener noreferrer">Visit the official APAB website<Icon name="external" size={16}/></a></>:<><p>{association.summary}</p><div class="association-actions"><a class="text-link" href={withBase('about/apab/')}>Read about APAB<Icon name="arrow" size={17}/></a><a class="text-link" href={association.url} target="_blank" rel="noopener noreferrer">Official association website<Icon name="external" size={16}/></a></div></>}
  </div>
</section>
