---
import conference from '../data/conference.json';
const questions=[['When and where is the conference?',`${conference.dateLabel}, at ${conference.venue.name}, ${conference.location}.`],['Is abstract submission open?','Abstract submission will open soon. The official Microsoft CMT link and approved guidelines will appear on the Abstract Submission pages.'],['When can I register?','The participant form is available in DEMO mode using synthetic information only. Actual registration is not open. Final fees and deadlines remain subject to committee approval.'],['Who is hosting the conference?',`${conference.host}, through the ${conference.faculty}.`],['Are speakers and the programme confirmed?','Keynote and invited speakers will be announced soon. The detailed scientific programme is under preparation.'],['Can I download an abstract template?','The committee-approved abstract template will be available on the Abstract Template page once provided.'],['How can I contact the committee?','The official conference email and secretariat details are awaiting confirmation. Check the Contact page for updates.']];
---
<div class="faq-list">{questions.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
