---
import dates from '../data/dates.json';
import conference from '../data/conference.json';
import planning from '../data/planning.json';
const format=(date:string)=>new Intl.DateTimeFormat('en',{dateStyle:'long',timeZone:conference.timeZone}).format(new Date(date.length===10?`${date}T12:00:00+08:00`:date));
const hasEstimates=dates.some(row=>!row.date&&(row.estimatedDate||row.estimatedLabel));
---
<div class="dates-content">
  {hasEstimates&&<p class="planning-note">The timetable below is provisional and awaits committee approval. {planning.deadlineLabel}</p>}
  <ol class="dates-list">{dates.map(date=><li class:list={{'conference-date':date.id==='conference'}}><span class="timeline-dot"></span><span>{date.label}</span><strong>{date.id==='conference'?conference.dateLabel:date.date?<time datetime={date.date}>{format(date.date)}</time>:date.estimatedDate||date.estimatedLabel?<span class="estimated-value">{date.estimatedDate?<time datetime={date.estimatedDate}>{format(date.estimatedDate)}</time>:date.estimatedLabel}<small>{planning.statusLabel}</small></span>:'To be announced'}</strong></li>)}</ol>
  {hasEstimates&&<details class="planning-method"><summary>About this provisional timetable</summary><p>{planning.method}</p><p>{planning.earlyBirdNote}</p></details>}
</div>
