---
import type {ConferencePage} from '../data/pages';
import conference from '../data/conference.json';
import {withBase} from '../utils/url';
import Topics from './Topics.astro';
import Speakers from './Speakers.astro';
import Committee from './Committee.astro';
import ImportantDates from './ImportantDates.astro';
import Programme from './Programme.astro';
import ExternalAction from './ExternalAction.astro';
import DownloadButton from './DownloadButton.astro';
import RegistrationTable from './RegistrationTable.astro';
import RegistrationForm from './RegistrationForm.astro';
import Sponsors from './Sponsors.astro';
import AnnouncementCards from './AnnouncementCards.astro';
import Faq from './Faq.astro';
import VenueCard from './VenueCard.astro';
import Association from './Association.astro';
interface Props {page:ConferencePage;}
const {page}=Astro.props;
const path=page.path;
const photos=conference.baliPhotos as {image:string;alt:string;credit:string}[];
---
<div class="prose">{page.paragraphs?.map(paragraph=><p>{paragraph}</p>)}</div>
{path==='about/apab/'&&<Association full/>}
{['travel/','travel/accommodation/','travel/transportation/'].includes(path)&&<VenueCard/>}
{page.blocks&&<div class="information-blocks">{page.blocks.map(block=><section><h2>{block.title}</h2><p>{block.text}</p></section>)}</div>}
{path==='programme/topics/'&&<Topics/>}
{path==='programme/'&&<><Programme/><DownloadButton path={conference.programmeDownload} label="Download programme"/></>}
{path==='programme/keynote-speakers/'&&<Speakers category="keynote"/>}
{path==='programme/invited-speakers/'&&<Speakers category="invited"/>}
{path==='about/organizing-committee/'&&<Committee/>}
{path==='about/scientific-committee/'&&<Committee scientific/>}
{(path==='about/host/'||path==='sponsorship/partners/')&&<Sponsors/>}
{path==='abstracts/'&&<><ExternalAction url={conference.cmtUrl} open={conference.submissionOpen} label="Submit via Microsoft CMT" unavailable="Abstract submission will open soon."/><section class="subsection"><h2>Submission information</h2><div class="link-grid">{[['Submission guidelines','abstracts/guidelines/'],['Abstract template','abstracts/template/'],['Oral & poster presentations','abstracts/presentations/'],['Scientific topics','programme/topics/']].map(([label,url])=><a href={withBase(url)}>{label}<span aria-hidden="true">↗</span></a>)}</div></section><section class="subsection"><h2>Important submission dates</h2><ImportantDates/></section><section class="subsection"><h2>Proposed scientific topics</h2><Topics/></section><DownloadButton path={conference.abstractTemplate} label="Download abstract template"/></>}
{path==='abstracts/portal/'&&<ExternalAction url={conference.cmtUrl} open={conference.submissionOpen} label="Submit via Microsoft CMT" unavailable="Abstract submission will open soon."/>}
{path==='abstracts/template/'&&<DownloadButton path={conference.abstractTemplate} label="Download abstract template"/>}
{path==='registration/'&&<><a class="button" href={withBase('registration/portal/')}>View participant registration form →</a><p class="registration-payment">Registration fees and payment arrangements will be announced once confirmed by the organizing committee.</p><RegistrationTable/><div class="link-grid">{[['Payment information','registration/payment/'],['Cancellation and refund policy','registration/cancellation/']].map(([label,url])=><a href={withBase(url)}>{label}<span aria-hidden="true">↗</span></a>)}</div></>}
{path==='registration/portal/'&&<RegistrationForm/>}
{path==='sponsorship/'&&<><DownloadButton path={conference.sponsorshipProspectus} label="Download sponsorship prospectus"/><div class="notice"><strong>Interested in supporting the conference?</strong><p>Secretariat contact details and the approved sponsorship process will be published here.</p><a class="text-link" href={withBase('contact/')}>Conference Secretariat →</a></div></>}
{path==='sponsorship/prospectus/'&&<DownloadButton path={conference.sponsorshipProspectus} label="Download sponsorship prospectus"/>}
{path==='important-dates/'&&<ImportantDates/>}
{path==='news/'&&<AnnouncementCards/>}
{path==='contact/faq/'&&<Faq/>}
{path==='contact/'&&conference.email&&<a class="button" href={`mailto:${conference.email}`}>Email the Conference Secretariat</a>}
{path==='travel/visa/'&&<a class="button secondary" href="https://www.imigrasi.go.id/" target="_blank" rel="noopener noreferrer">Indonesian Directorate General of Immigration ↗</a>}
{path==='travel/bali/'&&photos.map(photo=><figure class="destination-photo"><img src={withBase(photo.image)} alt={photo.alt} width="960" height="640" loading="lazy"/><figcaption>{photo.credit}</figcaption></figure>)}
