---
import programme from '../data/programme.json';
import topics from '../data/topics.json';
import conference from '../data/conference.json';
interface Entry {id:string;date:string;time:string;endTime?:string;title:string;type:string;topic:string;location?:string;speakers?:string[];approved:boolean;}
const entries=(programme.entries as Entry[]).filter(p=>p.approved);
const available=programme.published&&entries.length>0;
---
<div class="programme" data-programme>
<div class="day-tabs" role="group" aria-label="Programme dates"><button class="day-tab selected" data-day="all" aria-pressed="true">All days</button>{programme.days.map((day,i)=><button class="day-tab" data-day={day} aria-pressed="false"><span>Day {i+1}</span><strong>{new Intl.DateTimeFormat('en',{month:'short',day:'numeric',timeZone:conference.timeZone}).format(new Date(`${day}T12:00:00+08:00`))}</strong></button>)}</div>
{available?<><div class="programme-filters"><label>Session type<select data-type><option value="all">All session types</option>{[...new Set(entries.map(e=>e.type))].map(type=><option>{type}</option>)}</select></label><label>Scientific topic<select data-topic><option value="all">All topics</option>{topics.items.filter(topic=>entries.some(e=>e.topic===topic)).map(topic=><option>{topic}</option>)}</select></label></div><div class="schedule-entries">{entries.map(entry=><article class="schedule-entry" data-session data-date={entry.date} data-type={entry.type} data-topic={entry.topic}><div><time datetime={`${entry.date}T${entry.time}:00+08:00`}>{entry.time}{entry.endTime&&`–${entry.endTime}`}</time><small>{entry.date}</small></div><div><span class="pill">{entry.type}</span><h3>{entry.title}</h3><p>{entry.topic}</p>{entry.location&&<p>{entry.location}</p>}{entry.speakers&&<p>{entry.speakers.join(', ')}</p>}</div></article>)}</div><p class="notice" data-no-results hidden>No sessions match these filters.</p><p class="caption">All programme times are in {conference.timeZone} (UTC+08:00).</p></>:<div class="programme-empty"><span class="eyebrow" data-selected-day>FOUR DAYS OF SCIENTIFIC EXCHANGE</span><h2>The programme is taking shape.</h2><p>The detailed scientific programme is under preparation.<br/>Session times, speakers, and activities will be published after approval.</p><span class="pill">Details to be announced</span></div>}
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-programme]').forEach(root=>{let day='all';const filter=()=>{const type=root.querySelector<HTMLSelectElement>('select[data-type]')?.value||'all';const topic=root.querySelector<HTMLSelectElement>('select[data-topic]')?.value||'all';const sessions=root.querySelectorAll<HTMLElement>('[data-session]');let count=0;sessions.forEach(session=>{const show=(day==='all'||session.dataset.date===day)&&(type==='all'||session.dataset.type===type)&&(topic==='all'||session.dataset.topic===topic);session.hidden=!show;if(show)count++;});const empty=root.querySelector<HTMLElement>('[data-no-results]');if(empty)empty.hidden=count>0;};root.querySelectorAll<HTMLButtonElement>('[data-day]').forEach(button=>button.addEventListener('click',()=>{day=button.dataset.day!;root.querySelectorAll('[data-day]').forEach(other=>{other.classList.toggle('selected',other===button);other.setAttribute('aria-pressed',String(other===button));});const label=root.querySelector('[data-selected-day]');if(label)label.textContent=day==='all'?'FOUR DAYS OF SCIENTIFIC EXCHANGE':`Programme for ${day} · To be announced`;filter();}));root.querySelectorAll('select').forEach(select=>select.addEventListener('change',filter));});
</script>
