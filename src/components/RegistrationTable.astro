---
import data from '../data/registration.json';
const format=(value:number,currency:string)=>new Intl.NumberFormat('en',{style:'currency',currency,currencyDisplay:'code',minimumFractionDigits:0,maximumFractionDigits:2}).format(value);
const conversion=data.planningConversion;
const price=(approved:number|null,estimated:number|null)=>approved!==null&&data.currency?{text:format(approved,data.currency),estimated:false}:estimated!==null?{text:format(estimated*conversion.rate,conversion.to),estimated:true}:{text:'To be announced',estimated:false};
---
<div class="notice fee-notice"><strong>Confirmed 2027 fees: To be announced.</strong><p>{data.benchmark.note}</p><p><strong>Planning exchange rate: {format(1,conversion.from)} = {format(conversion.rate,conversion.to)}</strong><br/>Rate supplied for conference planning; not a live exchange-rate feed.</p><a class="text-link" href={data.benchmark.sourceUrl} target="_blank" rel="noopener noreferrer">View the 2025 fee reference ↗</a></div>
<div class="table-scroll" tabindex="0" role="region" aria-label="Registration fee table"><table><caption>2027 planning estimates in {conversion.to} · Subject to approval</caption><thead><tr><th scope="col">Participant category</th><th scope="col">Early-bird registration</th><th scope="col">Regular registration</th></tr></thead><tbody>{data.categories.map(row=><tr><th scope="row">{row.name}</th>{[price(row.earlyBird,row.estimatedEarlyBird),price(row.regular,row.estimatedRegular)].map(value=><td>{value.text}{value.estimated&&<small class="fee-estimate-label">Estimated</small>}</td>)}</tr>)}</tbody></table></div>
