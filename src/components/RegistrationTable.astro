---
import data from '../data/registration.json';
import dates from '../data/dates.json';
const format=(value:number,currency:string)=>new Intl.NumberFormat('en',{style:'currency',currency,currencyDisplay:'code',minimumFractionDigits:0,maximumFractionDigits:2}).format(value);
const price=(approved:number|null,estimated:number|null)=>approved!==null&&data.currency?{text:format(approved,data.currency),estimated:false}:estimated!==null?{text:format(estimated,data.planningCurrency),estimated:true}:{text:'To be announced',estimated:false};
const deadline=(id:string)=>{const date=dates.find(d=>d.id===id)?.estimatedDate;return date?new Intl.DateTimeFormat('en',{dateStyle:'long',timeZone:'Asia/Jakarta'}).format(new Date(date+'T12:00:00+07:00')):'To be announced';};
---
<div class="notice fee-notice"><strong>Confirmed 2027 fees: To be announced.</strong><p>{data.benchmark.note}</p><p>No payment is requested in this demonstration. Registration inclusions, payment methods and cancellation terms remain to be announced.</p></div>
<div class="table-scroll" tabindex="0" role="region" aria-label="Registration fee table"><table><caption>2027 planning estimates in {data.planningCurrency} · Subject to approval</caption><thead><tr><th scope="col">Participant category</th><th scope="col">Early-bird registration<span class="fee-period">Provisional deadline: {deadline('early-bird')}</span></th><th scope="col">Regular registration<span class="fee-period">Provisional deadline: {deadline('regular-registration')}</span></th></tr></thead><tbody>{data.categories.map(row=><tr><th scope="row">{row.name}</th>{[price(row.earlyBird,row.estimatedEarlyBird),price(row.regular,row.estimatedRegular)].map(value=><td>{value.text}{value.estimated&&<small class="fee-estimate-label">Provisional</small>}</td>)}</tr>)}</tbody></table></div>
