---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageBody from '../components/PageBody.astro';
import {pages,type ConferencePage} from '../data/pages';
import {navigation,routeOf} from '../data/navigation';
import {withBase} from '../utils/url';
export function getStaticPaths(){return pages.map(page=>({params:{route:page.path.replace(/\/$/,'')},props:{page}}));}
interface Props{page:ConferencePage;}
const {page}=Astro.props;
const related=navigation.find(group=>group.slug===page.groupSlug);
const pageGridClass=page.path==='registration/portal/'?'container page-grid registration-page':'container page-grid';
---
<Layout title={page.title} description={page.description}><div class="page-heading"><div class="container"><Breadcrumbs title={page.title} group={page.group} groupSlug={page.groupSlug}/><p class="eyebrow">{page.group}</p><h1>{page.title}</h1><p>{page.description}</p></div></div><div class={pageGridClass}><article class="page-content"><PageBody page={page}/></article>{related&&<aside class="page-sidebar"><h2>In this section</h2><nav aria-label={`${page.group} pages`}>{related.items.map(([label,slug])=><a href={withBase(routeOf(related.slug,slug))} aria-current={page.path===routeOf(related.slug,slug)?'page':undefined}>{label}<span aria-hidden="true">→</span></a>)}</nav><div class="sidebar-note"><span class="eyebrow">PLAN AHEAD</span><strong>Important dates</strong><p>Conference dates and provisional planning milestones.</p><a href={withBase('important-dates/')}>View dates →</a></div></aside>}</div></Layout>
