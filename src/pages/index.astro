---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import QuickAccess from '../components/QuickAccess.astro';
import ImportantDates from '../components/ImportantDates.astro';
import Countdown from '../components/Countdown.astro';
import Topics from '../components/Topics.astro';
import Speakers from '../components/Speakers.astro';
import AnnouncementCards from '../components/AnnouncementCards.astro';
import Sponsors from '../components/Sponsors.astro';
import Association from '../components/Association.astro';
import Icon from '../components/Icon.astro';
import conference from '../data/conference.json';
import {withBase} from '../utils/url';
const photos=conference.baliPhotos as {image:string;alt:string;credit:string}[];
---
<Layout title="Welcome to Bali">
  <Hero/><QuickAccess/><div class="venue-ribbon container"><span class="eyebrow">CONFERENCE VENUE</span><a href={withBase('travel/')}>{conference.venue.name}<Icon name="arrow" size={17}/></a><span>{conference.location}</span></div>
  <section class="section container welcome-grid"><div class="section-heading"><p class="eyebrow">WELCOME TO 14th APBiomech</p><h2>A meeting of minds.<br/>A world of possibilities.</h2><div class="section-rule"></div><p class="section-aside">Biomechanics across disciplines.<br/>Collaboration across borders.</p><a class="text-link" href={withBase('about/')}>About the conference<Icon size={17}/></a></div><div class="welcome-copy">{conference.welcome.map((paragraph,i)=><p class:list={{lead:i===0}}>{paragraph}</p>)}<div class="welcome-signature"><span class="signature-line"></span><div><strong>The Organizing Committee</strong><span>{conference.abbreviation}</span></div></div></div></section>
  <section class="section dates-section"><div class="container dates-grid"><div><p class="eyebrow">MARK YOUR CALENDAR</p><h2>Important dates</h2><p class="section-intro">Your milestones on the way to Bali.</p><div class="date-highlight"><Icon name="calendar" size={28}/><span>THE CONFERENCE<strong>{conference.dateLabel}</strong><small>{conference.location}</small></span></div><p class="caption">See the timeline for estimated milestones and their reference schedule.</p></div><ImportantDates/></div></section>
  <Countdown/>
  <section class="section container"><div class="section-top"><div><p class="eyebrow">THE SCIENCE THAT CONNECTS US</p><h2>Across scales. Across disciplines.</h2></div><a class="text-link" href={withBase('programme/topics/')}>Explore scientific topics<Icon size={17}/></a></div><p class="section-intro max-copy">From cells and tissues to human movement and intelligent systems, discover the breadth of biomechanics.</p><Topics/></section>
  <section class="section speaker-section"><div class="container"><div class="section-top"><div><p class="eyebrow">IDEAS. INSIGHT. INSPIRATION.</p><h2>Keynote & invited speakers</h2></div><a class="text-link" href={withBase('programme/keynote-speakers/')}>Speaker updates<Icon size={17}/></a></div><Speakers/></div></section>
  <section class="section container"><div class="section-top"><div><p class="eyebrow">STAY IN THE LOOP</p><h2>Latest announcements</h2></div><a class="text-link" href={withBase('news/')}>All updates<Icon size={17}/></a></div><AnnouncementCards limit={3}/></section>
  <section class="bali-section"><div class="container bali-inner"><div><p class="eyebrow">BEYOND THE CONFERENCE</p><h2>Scientific discovery.<br/><span>Balinese hospitality.</span></h2><p>Come for the exchange of ideas. Discover the culture, natural landscapes, and warm welcome of Bali, Indonesia.</p><a class="button light" href={withBase('travel/bali/')}>Discover Bali<Icon size={18}/></a></div><div class="bali-side">{photos.length?<figure><img src={withBase(photos[0].image)} alt={photos[0].alt} width="720" height="480" loading="lazy"/><figcaption>{photos[0].credit}</figcaption></figure>:<><span class="bali-place">Bali.</span><span class="bali-country">INDONESIA · ASIA / MAKASSAR</span><p>Culture. Connection. Discovery.</p></>}</div></div></section>
  <section class="section container"><Association/></section>
  <section class="section container hosts-section"><p class="eyebrow">BRINGING THE COMMUNITY TOGETHER</p><h2>Our host & association</h2><Sponsors/></section>
</Layout>
